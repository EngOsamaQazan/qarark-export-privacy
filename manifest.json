{
  "manifest_version": 3,
  "name": "تصدير تشريعات قرارك",
  "description": "تصدير نص التشريع المعروض في قرارك إلى ملف وورد منسق. إضافة غير رسمية.",
  "version": "1.0.0",
  "action": {
    "default_title": "تصدير التشريع إلى وورد",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "scripting", "downloads", "sidePanel"],
  "host_permissions": [
    "https://www.qarark.com/*",
    "https://qarark.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
